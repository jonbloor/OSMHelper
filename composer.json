{
    "name": "jonbloor/osmhelper",
    "description": "OSMHelper — Online Scout Manager helper tools (PHP rewrite)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6",
        "twig/twig": "^3.14",
        "guzzlehttp/guzzle": "^7.9",
        "league/oauth2-client": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
