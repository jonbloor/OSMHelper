{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>Group numbers — {{ groupName }}</h2>
  <p class="muted">Tick the sections you need, then load the numbers. These are the sections from when you signed in. Explorers, Adults, waiting lists, and sections switched off in Settings are left out. OSM is only asked for the ones you tick, plus the waiting list so the age bands can be filled in.</p>
  {% if sectionError %}<div class="alert alert-error">{{ sectionError }}</div>{% endif %}

  {% if choiceCount == 0 and not sectionError %}
  <p class="alert">No sections on this login that Group numbers can use. Sign out and connect again, or check Settings and your OSM role.</p>
  {% elseif choiceCount > 0 %}
  <form method="post" action="/membership-dashboard/" class="member-section-pick" data-member-sections>
    {% include '_csrf.twig' %}
    {% for g in groups %}
    <div class="member-section-group">
      {% if multiGroup %}<h3>{{ g.name }}</h3>{% endif %}
      <div class="filter-chips">
        {% for s in g.sections %}
        <label class="filter-chip">
          <input type="checkbox" name="section_ids[]" value="{{ s.id }}" {% if s.id in selectedIds %}checked{% endif %}>
          {{ s.name }} <span class="muted">{{ s.typeLabel }}</span>
        </label>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
    <p class="member-section-actions">
      <button type="button" class="btn btn-secondary" data-sections-all>Select all</button>
      <button type="button" class="btn btn-secondary" data-sections-none>Clear</button>
      <button class="btn" type="submit">Load numbers</button>
    </p>
  </form>
  {% endif %}
</div>

{% if loaded %}
<div class="card">
  <p class="muted">Updated {{ dataUpdated }} · Waiting of age {{ totalWaiting }} · Squirrels {{ squirrelsWaiting|default(0) }} · Too young {{ tooYoungWaiting }} · Explorers / too old {{ explorersWaiting|default(0) }} · All waiting {{ totalWaitingFull|default(0) }}</p>
  {% if waitingIncomplete|default(false) %}<p class="alert">Some waiting list ages could not be loaded this time, to protect your OSM allowance, so the waiting numbers may be low. Run this again in a few minutes.</p>{% endif %}
  <p class="muted chart-snapshot">Charts: snapshot as of this load (same data as the tables below — no extra OSM calls). Only the ticked sections were loaded.</p>

  {% set maxMembersSpaces = chartMaxMembersSpaces|default(1) %}
  {% set maxWaiting = chartMaxWaiting|default(1) %}

  <div class="chart-grid">
    <section class="chart-card" aria-label="Members vs spaces by section">
      <h3>Members vs spaces by section</h3>
      {% if chartSections|default([]) is empty %}
        <p class="muted">No section rows to chart.</p>
      {% else %}
        <ul class="bar-chart">
          {% for s in chartSections %}
            {% set memPct = maxMembersSpaces > 0 ? ((s.members|abs) / maxMembersSpaces * 100) : 0 %}
            {% set spVal = s.spaces is not null ? s.spaces : 0 %}
            {% set spPct = maxMembersSpaces > 0 ? ((spVal|abs) / maxMembersSpaces * 100) : 0 %}
            <li>
              <div class="bar-label">{{ s.name }}</div>
              <div class="bar-pair">
                <div class="bar-row">
                  <div class="bar-track" title="Members {{ s.members }}">
                    <span class="bar-fill bar-members" style="width: {{ memPct }}%"></span>
                  </div>
                  <span class="bar-value">{{ s.members }} mem</span>
                </div>
                <div class="bar-row">
                  <div class="bar-track" title="Spaces {{ s.spaces is not null ? s.spaces : 'n/a' }}">
                    <span class="bar-fill {{ s.overCapacity ? 'bar-over' : 'bar-spaces' }}" style="width: {{ spPct }}%"></span>
                  </div>
                  <span class="bar-value">{% if s.spaces is null %}—{% elseif s.overCapacity %}<span class="spaces-over">{{ s.spaces|abs }} over</span>{% else %}{{ s.spaces }} sp{% endif %}</span>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>

    <section class="chart-card" aria-label="Waiting by age band">
      <h3>Waiting by age band</h3>
      <ul class="bar-chart">
        {% for w in chartWaiting|default([]) %}
          {% set pct = maxWaiting > 0 ? (w.count / maxWaiting * 100) : 0 %}
          <li>
            <div class="bar-label">{{ w.label }}</div>
            <div class="bar-row">
              <div class="bar-track" title="{{ w.count }}">
                <span class="bar-fill band-{{ w.band|default('other') }}" style="width: {{ pct }}%"></span>
              </div>
              <span class="bar-value">{{ w.count }}</span>
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>

    <section class="chart-card" aria-label="Fullness percent by section type">
      <h3>Fullness % by section type</h3>
      {% if chartFullness|default([]) is empty %}
        <p class="muted">No section types with a set capacity.</p>
      {% else %}
        <ul class="bar-chart">
          {% for f in chartFullness %}
            {% set pct = f.pct > 100 ? 100 : (f.pct < 0 ? 0 : f.pct) %}
            <li>
              <div class="bar-label">{{ f.typeName }}</div>
              <div class="bar-row">
                <div class="bar-track" title="{{ f.members }} / {{ f.capacity }} ({{ f.pct }}%)">
                  <span class="bar-fill {{ f.pct > 100 ? 'bar-over' : 'band-' ~ (f.band|default('other')) }}" style="width: {{ pct }}%"></span>
                </div>
                <span class="bar-value">{{ f.pct }}% <span class="muted">({{ f.members }}/{{ f.capacity }})</span></span>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>
  </div>

  {% for typeName, g in grouped %}
    <h3>{{ typeName }}</h3>
    <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Section</th><th>Members</th><th>Leaders</th><th>YLs</th><th>Capacity</th><th>Spaces</th><th>Waiting</th></tr></thead>
      <tbody>
      {% for s in g.sections %}
        <tr>
          <td>{{ s.name }}</td><td>{{ s.members }}</td><td title="{{ s.leaderInitials }}">{{ s.leaders }}</td>
          <td title="{{ s.youngLeaderInitials }}">{{ s.youngLeaders }}</td><td>{{ s.capacity }}</td><td>{% if s.spaces is same as('-') or s.spaces is null %}—{% elseif s.spaces < 0 %}<span class="spaces-over">{{ (-s.spaces) }} over</span>{% else %}{{ s.spaces }}{% endif %}</td><td class="muted" title="Waiting is counted by age band, not per section">—</td>
        </tr>
      {% else %}
        {# Keep seven cells so Waiting still lines up with the header when there are no sections #}
        <tr class="row-no-section">
          <td class="muted">No OSM section of this type</td>
          <td>0</td>
          <td>0</td>
          <td>0</td>
          <td>0</td>
          <td>0</td>
          <td class="muted" title="Waiting is counted by age band on the subtotal row">—</td>
        </tr>
      {% endfor %}
      <tr class="subtotal"><td>Subtotal</td><td>{{ g.subtotalMembers }}</td><td>{{ g.subtotalLeaders }}</td><td>{{ g.subtotalYLs }}</td><td>{{ g.subtotalCapacity }}</td><td>{{ g.subtotalSpaces }}</td><td>{{ g.subtotalWaiting }}</td></tr>
      </tbody>
    </table>
    </div>
  {% else %}
    <p class="muted">No youth sections to show.</p>
  {% endfor %}
  <p><strong>Totals</strong> — members {{ totalMembers }}, leaders {{ totalLeaders }}, YLs {{ totalYLs }}, capacity {{ totalCapacity }}, spaces {{ totalSpaces }}</p>
</div>
{% endif %}
<script>
(function () {
  var form = document.querySelector('[data-member-sections]');
  if (!form) return;
  function boxes() {
    return Array.prototype.slice.call(form.querySelectorAll('input[name="section_ids[]"]'));
  }
  var allBtn = form.querySelector('[data-sections-all]');
  var noneBtn = form.querySelector('[data-sections-none]');
  if (allBtn) allBtn.addEventListener('click', function () { boxes().forEach(function (cb) { cb.checked = true; }); });
  if (noneBtn) noneBtn.addEventListener('click', function () { boxes().forEach(function (cb) { cb.checked = false; }); });
})();
</script>
{% endblock %}
