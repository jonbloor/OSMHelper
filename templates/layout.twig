<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != 'OSMHelper' %}{{ title }} · {% endif %}OSMHelper</title>
  <link rel="stylesheet" href="/assets/app.css?v=d6badge2">
  <script src="/assets/table-tools.js?v=d6badge2" defer></script>
</head>
<body>
  <div id="page-loading" class="page-loading" hidden aria-live="polite" aria-busy="true">
    <span class="page-loading-box"><span class="loading-spinner" aria-hidden="true"></span> Loading… Please wait.</span>
  </div>
  <div class="wrap wrap-wide">
    <header class="app-header">
      <h1><a href="/">OSMHelper</a></h1>
      {% if authed is defined and authed %}
      <button type="button" class="nav-toggle" aria-controls="app-nav" aria-expanded="false">Menu</button>
      <nav id="app-nav" class="nav-links">
        <a class="nav-item nav-home" href="/dashboard/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 10v10h14V10"/></svg> Home</a>

        <details class="nav-group nav-members">
          <summary><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Members</summary>
          <div class="nav-sub">
            <a href="/membership-dashboard/">Group numbers</a>
            <a href="/members/">Members</a>
            <a href="/member-checks/">Checks</a>
            <a href="/waiting-list/">Waiting</a>
          </div>
        </details>

        <details class="nav-group nav-badges">
          <summary><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M8.21 13.89 7 22l5-3 5 3-1.21-8.11"/></svg> Badges</summary>
          <div class="nav-sub">
            <a href="/top-awards/">Top awards</a>
          </div>
        </details>

        <a class="nav-item nav-equipment" href="/equipment/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7 12 12l8.7-5"/><path d="M12 22V12"/></svg> Equipment</a>

        <details class="nav-group nav-finance">
          <summary><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/></svg> Finance</summary>
          <div class="nav-sub">
            <a href="/bank-transfers/">Bank</a>
            <a href="/bank-transfers/all/">All transfers</a>
          </div>
        </details>

        <a class="nav-item nav-settings" href="/settings/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg> Settings</a>
        <a class="nav-item nav-help" href="/help/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg> Help</a>
        <a class="nav-item nav-roadmap" href="/roadmap/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg> Roadmap</a>
        <a class="nav-item nav-logout" href="/logout/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg> Logout</a>
      </nav>
      <script>
        (function () {
          var btn = document.querySelector('.nav-toggle');
          var nav = document.getElementById('app-nav');
          if (!btn || !nav) return;
          var mq = window.matchMedia('(max-width: 720px)');
          function sync() {
            if (!mq.matches) {
              nav.classList.add('is-open');
              btn.setAttribute('aria-expanded', 'true');
            } else {
              nav.classList.remove('is-open');
              btn.setAttribute('aria-expanded', 'false');
            }
          }
          btn.addEventListener('click', function () {
            var open = nav.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          if (mq.addEventListener) mq.addEventListener('change', sync);
          else if (mq.addListener) mq.addListener(sync);
          sync();
          nav.querySelectorAll('details.nav-group').forEach(function (d) {
            d.addEventListener('toggle', function () {
              if (!d.open) return;
              nav.querySelectorAll('details.nav-group').forEach(function (o) {
                if (o !== d) o.open = false;
              });
            });
          });
          var path = window.location.pathname.replace(/\/+$/, '') || '/';
          nav.querySelectorAll('a[href]').forEach(function (a) {
            try {
              var p = new URL(a.href, window.location.href).pathname.replace(/\/+$/, '') || '/';
              if (p === path || (p !== '/' && path.indexOf(p) === 0)) {
                a.setAttribute('aria-current', 'page');
                var g = a.closest('details.nav-group');
                if (g) g.open = true;
              }
            } catch (e) {}
          });
        })();
      </script>
      {% else %}
      <nav class="nav-links nav-public">
        <a class="nav-item nav-home" href="/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 10v10h14V10"/></svg> Home</a>
        <a class="nav-item nav-help" href="/help/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg> Help</a>
        <a class="nav-item nav-roadmap" href="/roadmap/"><svg class="nav-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg> Roadmap</a>
      </nav>
      {% endif %}
    </header>
    {% block body %}{% endblock %}
    <footer class="app-footer"><a href="/">OSM Helper</a> - Tools to make OSM Better</footer>
  </div>
  <script>
    (function () {
      var el = document.getElementById('page-loading');
      if (!el) return;
      function show() { el.hidden = false; document.body.classList.add('is-loading'); }
      document.addEventListener('click', function (e) {
        if (e.defaultPrevented) return;
        if (e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('javascript:') === 0) return;
        if (a.target === '_blank' || a.hasAttribute('download')) return;
        try {
          var url = new URL(a.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return;
        } catch (err) { return; }
        show();
      }, true);
      document.addEventListener('submit', function () { show(); }, true);
    })();
  </script>
</body>
</html>
