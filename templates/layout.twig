<!DOCTYPE html>
<html lang="en-GB" class="no-js">
<head>
  <meta charset="utf-8">
  <script>document.documentElement.className = document.documentElement.className.replace(/\bno-js\b/, 'js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{% if pageTitle is defined and pageTitle %}{{ pageTitle }}{% else %}{% if title and title != 'OSMHelper' %}{{ title }} · {% endif %}OSMHelper{% endif %}{% endblock %}</title>
  {% block meta %}{% if metaDescription is defined and metaDescription %}<meta name="description" content="{{ metaDescription }}">{% endif %}{% endblock %}
  <link rel="stylesheet" href="{{ asset('app.css') }}">
  <script src="{{ asset('table-tools.js') }}" defer></script>
</head>
<body{% if bodyClass is defined and bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <div id="page-loading" class="page-loading" hidden aria-live="polite" aria-busy="true">
    <span class="page-loading-box"><span class="loading-spinner" aria-hidden="true"></span> Loading… Please wait.</span>
  </div>
  <div class="wrap wrap-wide">
    <header class="app-header">
      <h1><a href="/">OSMHelper</a></h1>
      <button type="button" class="nav-toggle" aria-controls="app-nav" aria-expanded="false">Menu</button>
      {% import '_nav_icons.twig' as navicon %}
      {% set signedIn = authed is defined and authed %}
      <nav id="app-nav" class="nav-links{% if not signedIn %} nav-public{% endif %}" aria-label="Main">
        {% for entry in main_nav(signedIn) %}
          {% if entry.type == 'group' %}
        <details class="nav-group nav-{{ entry.key }}{% if entry.hasCurrent %} has-current{% endif %}">
          <summary>{{ navicon.icon(entry.icon) }} {{ entry.label }}</summary>
          <div class="nav-sub">
            {% for item in entry.items %}
            <a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
          </div>
        </details>
          {% else %}
        <a class="nav-item nav-{{ entry.key }}" href="{{ entry.href }}"{% if entry.current %} aria-current="page"{% endif %}>{{ navicon.icon(entry.icon) }} {{ entry.label }}</a>
          {% endif %}
        {% endfor %}
      </nav>
      <script>
        (function () {
          var btn = document.querySelector('.nav-toggle');
          var nav = document.getElementById('app-nav');
          if (!btn || !nav) return;
          var mq = window.matchMedia('(max-width: 720px)');
          function sync() {
            if (!mq.matches) {
              nav.classList.add('is-open');
              btn.setAttribute('aria-expanded', 'true');
            } else {
              nav.classList.remove('is-open');
              btn.setAttribute('aria-expanded', 'false');
            }
          }
          btn.addEventListener('click', function () {
            var open = nav.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          if (mq.addEventListener) mq.addEventListener('change', sync);
          else if (mq.addListener) mq.addListener(sync);
          sync();
          // Dropdown groups (<details>): only one open at a time; close on outside click/tap,
          // Escape, choosing an item, closing the mobile menu, and when the page is restored from
          // the back/forward cache. The group holding the current page is highlighted (server-side),
          // not opened, so a menu never "sticks" open over the page on load.
          var groups = Array.prototype.slice.call(nav.querySelectorAll('details.nav-group'));
          function syncAria(d) {
            var s = d.querySelector('summary');
            if (s) s.setAttribute('aria-expanded', d.open ? 'true' : 'false');
          }
          function closeAll(except) {
            groups.forEach(function (o) { if (o !== except && o.open) o.open = false; });
          }
          groups.forEach(function (d) {
            syncAria(d);
            d.addEventListener('toggle', function () {
              syncAria(d);
              if (d.open) closeAll(d);
            });
            d.querySelectorAll('.nav-sub a').forEach(function (a) {
              a.addEventListener('click', function () { d.open = false; });
            });
          });
          document.addEventListener('click', function (e) {
            var inGroup = e.target && e.target.closest && e.target.closest('details.nav-group');
            closeAll(inGroup || null);
          });
          document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape' && e.key !== 'Esc') return;
            var open = groups.filter(function (d) { return d.open; })[0];
            if (!open) return;
            open.open = false;
            var s = open.querySelector('summary');
            if (s) s.focus();
          });
          nav.addEventListener('focusout', function (e) {
            // On phones the open group pushes the others down. Closing it the moment focus
            // moves to another group's heading would shift that heading before the tap lands,
            // so leave it: opening the other group closes this one (toggle handler above).
            var t = e.relatedTarget;
            if (mq.matches && t && t.tagName === 'SUMMARY' && nav.contains(t)) return;
            groups.forEach(function (d) {
              if (d.open && t && !d.contains(t)) d.open = false;
            });
          });
          btn.addEventListener('click', function () {
            if (!nav.classList.contains('is-open')) closeAll(null);
          });
          window.addEventListener('pageshow', function () { closeAll(null); });
          // The current page is marked on the server (aria-current + .has-current), see src/Http/Nav.php.
        })();
      </script>
    </header>
    {% if authed is defined and authed and sessionEndsText|default(null) %}
      <p class="session-ends" title="For privacy, every session ends {{ sessionLengthText|default('2 hours') }} after you sign in, even while you’re using it.">Signed in until {{ sessionEndsText }} (UK time)</p>
    {% endif %}
    {% if authed is defined and authed and rateLimit is defined %}
      {% if osmBlocked|default(false) %}
      <div class="alert alert-error rate-limit-banner osm-busy-banner" role="alert"><strong>OSM has blocked OSMHelper.</strong> OSMHelper has stopped all requests to OSM, for everyone, until the site administrator clears the block. Please don’t keep retrying. <a href="/help/#osm-busy">Why?</a></div>
      {% elseif osmBusyMinutes|default(null) %}
      <div class="alert alert-error rate-limit-banner osm-busy-banner" role="status">OSM is busy, try again in <strong>{{ osmBusyMinutes }} minute{{ osmBusyMinutes == 1 ? '' : 's' }}</strong>. {% if osmBusyHard|default(false) %}OSM asked us to slow down, so OSMHelper has stopped sending it requests for now.{% else %}Your OSM allowance is low, so OSMHelper is only making essential requests (like saves you confirm).{% endif %} <a href="/help/#osm-busy">Why?</a></div>
      {% elseif rateLimitCritical|default(false) %}
      <div class="alert alert-error rate-limit-banner" role="status">OSM API allowance critical: <strong>{{ rateLimit.remaining }}</strong> remaining{% if rateLimit.limit %} of {{ rateLimit.limit }}{% endif %}. Avoid heavy pages until it resets ({{ rateResetText|default('soon') }}).</div>
      {% elseif rateLimitNearing|default(false) %}
      <div class="alert rate-limit-banner rate-limit-nearing" role="status">Nearing OSM rate limit: <strong>{{ rateLimit.remaining }}</strong> remaining{% if rateLimit.limit %} of {{ rateLimit.limit }}{% endif %} (resets {{ rateResetText|default('soon') }}). Prefer cache over Refresh on Top awards and other heavy tools.</div>
      {% endif %}
    {% endif %}
    {% block body %}{% endblock %}
    <footer class="app-footer">
      <p class="footer-links"><a href="/">OSMHelper</a> · An independent volunteer project by Jon Bloor · <a href="/help/">Help</a> · <a href="/roadmap/">Roadmap</a> · <a href="mailto:hello@jonbloor.co.uk">hello@jonbloor.co.uk</a></p>
      <p class="footer-disclaimer">OSMHelper is an independent tool built by a Scout volunteer. It isn't made, run or endorsed by Online Scout Manager or The Scout Association.</p>
    </footer>
  </div>
  <script>
    (function () {
      var el = document.getElementById('page-loading');
      if (!el) return;
      function isLogoutLink(a) {
        return !!(a && (a.classList.contains('nav-logout') || (a.getAttribute('href') || '').indexOf('/logout') === 0));
      }
      function lockUi() {
        el.hidden = false;
        document.body.classList.add('is-loading');
        document.querySelectorAll('#app-nav a:not(.nav-logout), #app-nav summary, .nav-toggle, a.btn, button.btn, button[type="submit"], input[type="submit"]').forEach(function (n) {
          n.setAttribute('aria-disabled', 'true');
          if (n.tagName === 'BUTTON' || n.tagName === 'INPUT') {
            n.disabled = true;
          }
        });
      }
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (document.body.classList.contains('is-loading')) {
          if (isLogoutLink(a)) return;
          if (a || (e.target.closest && e.target.closest('button, input[type="submit"], summary'))) {
            e.preventDefault();
            e.stopPropagation();
          }
          return;
        }
        if (e.defaultPrevented) return;
        if (e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (!a) return;
        if (isLogoutLink(a)) return;
        var href = a.getAttribute('href') || '';
        if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('javascript:') === 0) return;
        if (a.target === '_blank' || a.hasAttribute('download')) return;
        try {
          var url = new URL(a.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return;
        } catch (err) { return; }
        lockUi();
      }, true);
      document.addEventListener('submit', function (e) {
        if (document.body.classList.contains('is-loading')) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        lockUi();
      }, true);
    })();
  </script>
</body>
</html>
