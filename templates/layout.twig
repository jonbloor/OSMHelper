<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != 'OSMHelper' %}{{ title }} · {% endif %}OSMHelper</title>
  <link rel="stylesheet" href="/assets/app.css?v=d6tbl3">
  <script src="/assets/table-tools.js?v=d6tbl3" defer></script>
</head>
<body>
  <div id="page-loading" class="page-loading" hidden aria-live="polite" aria-busy="true">
    <span class="page-loading-box"><span class="loading-spinner" aria-hidden="true"></span> Loading… Please wait.</span>
  </div>
  <div class="wrap wrap-wide">
    <header class="app-header">
      <h1><a href="/">OSMHelper</a></h1>
      {% if authed is defined and authed %}
      <button type="button" class="nav-toggle" aria-controls="app-nav" aria-expanded="false">Menu</button>
      <nav id="app-nav" class="nav-links">
        <a href="/dashboard/">Home</a>
        <a href="/membership-dashboard/" title="Group numbers">Dashboard</a>
        <a href="/members/">Members</a>
        <a href="/member-checks/" title="Member checks">Checks</a>
        <a href="/waiting-list/" title="Waiting list">Waiting</a>
        <a href="/equipment/">Equipment</a>
        <a href="/bank-transfers/" title="Bank transfers">Bank</a>
        <a href="/settings/">Settings</a>
        <a href="/help/">Help</a>
        <a href="/roadmap/">Roadmap</a>
        <a class="nav-logout" href="/logout/">Logout</a>
      </nav>
      <script>
        (function () {
          var btn = document.querySelector('.nav-toggle');
          var nav = document.getElementById('app-nav');
          if (!btn || !nav) return;
          var mq = window.matchMedia('(max-width: 720px)');
          function sync() {
            if (!mq.matches) {
              nav.classList.add('is-open');
              btn.setAttribute('aria-expanded', 'true');
            } else {
              nav.classList.remove('is-open');
              btn.setAttribute('aria-expanded', 'false');
            }
          }
          btn.addEventListener('click', function () {
            var open = nav.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          if (mq.addEventListener) mq.addEventListener('change', sync);
          else if (mq.addListener) mq.addListener(sync);
          sync();
        })();
      </script>
      {% else %}
      <nav class="nav-links nav-public">
        <a href="/">Home</a>
        <a href="/help/">Help</a>
        <a href="/roadmap/">Roadmap</a>
      </nav>
      {% endif %}
    </header>
    {% block body %}{% endblock %}
    <footer class="app-footer"><a href="/">OSM Helper</a> - Tools to make OSM Better</footer>
  </div>
  <script>
    (function () {
      var el = document.getElementById('page-loading');
      if (!el) return;
      function show() { el.hidden = false; document.body.classList.add('is-loading'); }
      document.addEventListener('click', function (e) {
        if (e.defaultPrevented) return;
        if (e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('javascript:') === 0) return;
        if (a.target === '_blank' || a.hasAttribute('download')) return;
        try {
          var url = new URL(a.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return;
        } catch (err) { return; }
        show();
      }, true);
      document.addEventListener('submit', function () { show(); }, true);
    })();
  </script>
</body>
</html>
