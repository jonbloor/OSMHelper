{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>Members — {{ groupName }}</h2>
  <p class="muted">Tick the sections you need, then load the list. These are the sections from when you signed in. OSM is only asked for the ones you tick.</p>
  {% if sectionError %}<div class="alert alert-error">{{ sectionError }}</div>{% endif %}

  {% if choiceCount == 0 and not sectionError %}
  <p class="alert">No sections on this login that a member list can use. Sign out and connect again, or check your OSM role.</p>
  {% elseif choiceCount > 0 %}
  <form method="post" action="/members/" class="member-section-pick" data-member-sections>
    {% include '_csrf.twig' %}
    {% for g in groups %}
    <div class="member-section-group">
      {% if multiGroup %}<h3>{{ g.name }}</h3>{% endif %}
      <div class="filter-chips">
        {% for s in g.sections %}
        <label class="filter-chip">
          <input type="checkbox" name="section_ids[]" value="{{ s.id }}" {% if s.id in selectedIds %}checked{% endif %}>
          {{ s.name }} <span class="muted">{{ s.typeLabel }}</span>
        </label>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
    <p class="member-section-actions">
      <button type="button" class="btn btn-secondary" data-sections-all>Select all</button>
      <button type="button" class="btn btn-secondary" data-sections-none>Clear</button>
      <button class="btn" type="submit">Load members</button>
    </p>
    <p class="muted">Loading fetches each ticked section from OSM and can take a moment. Leaders in a Leaders patrol are left off the list.</p>
  </form>
  {% endif %}
</div>

{% if loaded %}
<div class="card">
  <h3>Member list</h3>
  <p class="muted">Fetched {{ fetchedAt }}. Only the ticked sections were loaded. For Young Leaders / Leaders / multi-section checks see <a href="/member-checks/">Member checks</a>. Overnight camps: <a href="/nights-away/">Nights away</a>.</p>
  {% if errorMessage %}<div class="alert alert-error">{{ errorMessage }}</div>{% endif %}

  {% if sectionNames %}
  <div class="section-filters" id="section-filters" data-members-filter>
    <p class="muted" style="margin-bottom:0.35rem">Show sections:</p>
    <div class="filter-chips">
      <label class="filter-chip"><input type="checkbox" data-filter-all checked> All</label>
      {% for name in sectionNames %}
      <label class="filter-chip"><input type="checkbox" data-filter-section value="{{ name }}" checked> {{ name }}</label>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="table-wrap">
  <table class="data" id="members-table" data-table-tools data-export-name="members">
    <thead><tr><th>Section</th><th>Type</th><th>Name</th><th>Patrol</th><th>Age</th><th>DoB</th><th>Nights</th></tr></thead>
    <tbody>
    {% for m in members %}
      <tr data-section="{{ m.section_name }}">
        <td>{{ m.section_name }}</td><td>{{ m.section_type }}</td><td>{{ m.firstname }} {{ m.lastname }}</td><td>{{ m.patrol }}</td><td>{{ m.age }}</td><td>{{ m.dob }}</td>
        <td>{% if m.scoutid %}<a href="/nights-away/?scoutid={{ m.scoutid|url_encode }}">Nights</a>{% endif %}</td>
      </tr>
    {% else %}
      <tr><td colspan="7" class="muted">No members loaded.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="muted"><span id="members-visible-count">{{ members|length }}</span> shown</p>
</div>
<script>
(function () {
  var root = document.querySelector('[data-members-filter]');
  var table = document.getElementById('members-table');
  if (!root || !table) return;
  var allCb = root.querySelector('[data-filter-all]');
  var sectionCbs = Array.prototype.slice.call(root.querySelectorAll('[data-filter-section]'));
  var countEl = document.getElementById('members-visible-count');
  function apply() {
    var enabled = {};
    sectionCbs.forEach(function (cb) {
      if (cb.checked) enabled[cb.value] = true;
    });
    var rows = table.querySelectorAll('tbody tr[data-section]');
    var visible = 0;
    rows.forEach(function (tr) {
      var show = !!enabled[tr.getAttribute('data-section') || ''];
      tr.dataset.filterHidden = show ? '0' : '1';
      tr.hidden = !show;
      if (show) visible++;
    });
    if (countEl) countEl.textContent = String(visible);
    if (allCb) {
      allCb.checked = sectionCbs.length > 0 && sectionCbs.every(function (cb) { return cb.checked; });
      allCb.indeterminate = !allCb.checked && sectionCbs.some(function (cb) { return cb.checked; });
    }
  }
  if (allCb) {
    allCb.addEventListener('change', function () {
      sectionCbs.forEach(function (cb) { cb.checked = allCb.checked; });
      apply();
    });
  }
  sectionCbs.forEach(function (cb) {
    cb.addEventListener('change', apply);
  });
  apply();
})();
</script>
{% endif %}
<script>
(function () {
  var form = document.querySelector('[data-member-sections]');
  if (!form) return;
  function boxes() {
    return Array.prototype.slice.call(form.querySelectorAll('input[name="section_ids[]"]'));
  }
  var allBtn = form.querySelector('[data-sections-all]');
  var noneBtn = form.querySelector('[data-sections-none]');
  if (allBtn) allBtn.addEventListener('click', function () { boxes().forEach(function (cb) { cb.checked = true; }); });
  if (noneBtn) noneBtn.addEventListener('click', function () { boxes().forEach(function (cb) { cb.checked = false; }); });
})();
</script>
{% endblock %}
