{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>Members — {{ groupName }}</h2>
  <p class="muted">Fetched {{ fetchedAt }}</p>
  {% if errorMessage %}<div class="alert alert-error">{{ errorMessage }}</div>{% endif %}
</div>

<div class="card">
  <h2>Troubleshooting</h2>

  <h3>Youth in multiple sections</h3>
  {% if youthDuplicates %}
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>Name</th><th>Age</th><th>Sections</th></tr></thead>
    <tbody>
    {% for m in youthDuplicates %}
      <tr><td>{{ m.firstname }} {{ m.lastname }}</td><td>{{ m.age }}</td><td>{{ m.sections }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
    <p class="muted">No youth multi-section issues found.</p>
  {% endif %}

  <h3>Young Leaders checks</h3>
  {% if ylMembers %}
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>Name</th><th>Sections</th><th>Status</th></tr></thead>
    <tbody>
    {% for m in ylMembers %}
      <tr class="{% if m.statusOk %}status-ok{% else %}status-warn{% endif %}">
        <td>{{ m.firstname }} {{ m.lastname }}</td>
        <td>{{ m.sections }}</td>
        <td class="{% if m.statusOk %}status-ok{% else %}status-warn{% endif %}">{{ m.issue }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
    <p class="muted">No Young Leaders found.</p>
  {% endif %}

  <h3>Leaders checks</h3>
  {% if leaderMembers %}
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>Name</th><th>Sections</th><th>Status</th></tr></thead>
    <tbody>
    {% for m in leaderMembers %}
      <tr class="{% if m.statusOk %}status-ok{% else %}status-warn{% endif %}">
        <td>{{ m.firstname }} {{ m.lastname }}</td>
        <td>{{ m.sections }}</td>
        <td class="{% if m.statusOk %}status-ok{% else %}status-warn{% endif %}">{{ m.issue }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
    <p class="muted">No Leaders found.</p>
  {% endif %}
</div>

<div class="card">
  <h2>Members</h2>
  <p class="muted">Youth and Young Leaders (Leaders patrol rows listed separately below).</p>
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>Section</th><th>Type</th><th>Name</th><th>Patrol</th><th>Age</th><th>DoB</th></tr></thead>
    <tbody>
    {% for m in members %}
      <tr><td>{{ m.section_name }}</td><td>{{ m.section_type }}</td><td>{{ m.firstname }} {{ m.lastname }}</td><td>{{ m.patrol }}</td><td>{{ m.age }}</td><td>{{ m.dob }}</td></tr>
    {% else %}
      <tr><td colspan="6" class="muted">No members loaded.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</div>

{% if leaderRoster %}
<div class="card">
  <h2>Leaders</h2>
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>Name</th><th>Sections</th><th>Age</th><th>DoB</th></tr></thead>
    <tbody>
    {% for m in leaderRoster %}
      <tr><td>{{ m.firstname }} {{ m.lastname }}</td><td>{{ m.sections }}</td><td>{{ m.age }}</td><td>{{ m.dob }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endif %}
{% endblock %}
