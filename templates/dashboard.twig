{% extends 'layout.twig' %}
{% block body %}
  <div class="card">
    <div class="row" style="justify-content: space-between;">
      <h2 style="margin:0;">Dashboard</h2>
      <span class="badge">Signed in</span>
    </div>
    <dl class="meta">
      <dt>Name</dt><dd>{{ fullName }}</dd>
      <dt>Email</dt><dd>{{ email }}</dd>
      <dt>Group</dt><dd>{{ groupName }}</dd>
    </dl>
    <div class="tool-grid">
      <a class="btn" href="/membership-dashboard/">Group numbers</a>
      <a class="btn" href="/members/">Members</a>
      <a class="btn" href="/waiting-list/">Waiting list</a>
      <a class="btn" href="/equipment/">Equipment</a>
      <a class="btn" href="/bank-transfers/">Bank transfers</a>
      <a class="btn btn-secondary" href="/settings/">Settings</a>
    </div>
  </div>
{% endblock %}
