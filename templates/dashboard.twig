{% extends 'layout.twig' %}
{% block body %}
  <div class="card">
    <div class="row" style="justify-content: space-between;">
      <h2 style="margin:0;">Home</h2>
      <span class="badge">Signed in</span>
    </div>
    <dl class="meta">
      <dt>Name</dt><dd>{{ fullName }}</dd>
      <dt>Email</dt><dd>{{ email }}</dd>
      <dt>Group</dt><dd>{{ groupName }}</dd>
    </dl>
    {% include '_rate_limit.twig' %}
    <p class="muted">Use the navigation above to open Group numbers, Members, Waiting, Equipment, Bank, and Settings.</p>
  </div>
{% endblock %}
