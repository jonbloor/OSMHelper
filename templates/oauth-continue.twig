{% extends 'layout.twig' %}

{% block body %}
  <div class="card signin-continue">
    <h2>Sign in with OSM</h2>
    {% if retry %}
      <p>Press the button to sign in with Online Scout Manager again. Stay in this browser until you're back here.</p>
    {% elseif repeated %}
      <p>You've signed in several times in the last few minutes, but this browser may not be keeping you signed in, so we haven't sent you straight back to OSM. Check that cookies are allowed for this site, then press the button to try again.</p>
    {% else %}
      <p>It looks like signing in didn't finish just now, so we haven't sent you straight back to OSM. Press the button to try again.</p>
    {% endif %}
    <p><a class="btn" href="/auth/?go=1">Continue to OSM</a></p>
    {% include '_signin_app_tip.twig' %}
    <p><a class="btn btn-secondary" href="/">Back home</a></p>
  </div>
{% endblock %}
