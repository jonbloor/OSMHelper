{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>Confirm write to OSM</h2>
  <p>Section: <strong>{{ section.name }}</strong> <span class="muted">({{ section.type }})</span></p>
  {% if challengeBadge %}
  <p>Challenge badge: <strong>{{ challengeBadge.name }}</strong>
    · field <code>{{ progressField|default('completed') }}</code>
  </p>
  {% endif %}
  {% if writesPaused|default(true) %}
  <div class="alert alert-error"><strong>Writes paused.</strong> Do not Apply until OSM quota recovers and a Network capture of editing a challenge progress cell is pasted via Bungle. No new write URL will be invented.</div>
  {% else %}
  <div class="alert">Review each current → proposed change. Nothing is written until you click <strong>Write to OSM</strong>.</div>
  {% endif %}
  {% if notes %}
  <details><summary class="muted">Notes</summary><ul>{% for n in notes %}<li>{{ n }}</li>{% endfor %}</ul></details>
  {% endif %}
  <div class="table-wrap">
  <table class="data" data-table-tools data-export-name="top-awards-confirm">
    <thead>
      <tr>
        <th>Name</th>
        <th>Patrol</th>
        <th>Total</th>
        <th>Current progress</th>
        <th>Proposed progress</th>
      </tr>
    </thead>
    <tbody>
    {% for c in changes %}
      <tr>
        <td>{{ c.name }}</td>
        <td>{{ c.patrol }}</td>
        <td>{{ c.total }}</td>
        <td><code>{{ c.current|default('—') }}</code></td>
        <td><code>{{ c.proposed }}</code></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <form method="post" action="/top-awards/apply/" class="row" style="margin-top:1rem">
    {% include '_csrf.twig' %}
    {% if writesPaused|default(true) %}
    <button class="btn" type="submit" disabled>Write to OSM (paused)</button>
    {% else %}
    <button class="btn" type="submit">Write to OSM</button>
    {% endif %}
    <a class="btn btn-secondary" href="/top-awards/">Cancel</a>
  </form>
</div>
{% endblock %}
