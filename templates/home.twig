{% extends 'layout.twig' %}

{% block body %}
{% if authed %}
  <p class="slow-fetch-warning muted">Some tools take a moment — we fetch fresh data from OSM.</p>
  <div class="card home-signed-in">
    <h2>{% if groupName %}{{ groupName }}{% else %}Your group{% endif %}</h2>
    <p class="muted">
      Signed in{% if fullName %} as <strong>{{ fullName }}</strong>{% endif %}.
      Tools use your OSM account; data is fetched when you open each page.
    </p>
    {% include '_rate_limit.twig' %}
    <div class="row">
      <a class="btn btn-secondary" href="/help/">Help</a>
      <a class="btn btn-secondary" href="/logout/">Logout</a>
    </div>
  </div>
{% else %}
  <section class="home-hero card">
    <p class="eyebrow">Volunteer Scouts tooling</p>
    <h2>OSMHelper for group leaders</h2>
    <p class="lede">
      Connect with Online Scout Manager once, then check group numbers, the waiting list,
      members, equipment and bank transfers without digging through OSM screens.
    </p>
    <p>
      <a class="btn" href="/auth/">Connect with OSM</a>
    </p>
    <p class="muted home-oauth-note">
      You will be sent to OSM to authorise. We only keep your access token in the server session.
    </p>
  </section>

  <section class="card home-tools">
    <h3>What you can do</h3>
    <ul class="tool-cards">
      <li>
        <strong>Group numbers</strong>
        <span>Section membership, leaders, capacity and spaces — plus snapshot charts for members vs spaces, waiting by age band, and fullness %.</span>
      </li>
      <li>
        <strong>Waiting list</strong>
        <span>Who is waiting, age scoring, and who is still too young.</span>
      </li>
      <li>
        <strong>Members</strong>
        <span>Browse youth members with section filters; ages filled from OSM where needed.</span>
      </li>
      <li>
        <strong>Checks</strong>
        <span>Youth in multiple sections, Young Leaders and Leaders status checks.</span>
      </li>
      <li>
        <strong>Equipment</strong>
        <span>Quartermaster lists and items for the section you pick in Settings — sortable, searchable, exportable.</span>
      </li>
      <li>
        <strong>Bank transfers</strong>
        <span>Finance transfer view for the section you pick in Settings.</span>
      </li>
      <li>
        <strong>Settings</strong>
        <span>Age cutoffs, section capacity, Equipment and Bank section picks, and a named list of kit locations.</span>
      </li>
      <li>
        <strong>Help</strong>
        <span>Plain-English guide to each tool, plus how rate limits work.</span>
      </li>
      <li>
        <strong>Roadmap</strong>
        <span>What is coming next (writes, badges, backlog) and how to request features.</span>
      </li>
    </ul>
  </section>

  <section class="card home-trust">
    <h3>Privacy &amp; independence</h3>
    <p class="disclaimer">
      This is an independent project, not affiliated with Online Scout Manager. Use it at your own risk.
    </p>
    <p class="muted">
      We only keep your OSM access token in a server session (not stored as lasting scout records).
      No scout data is permanently saved on this server — pages fetch fresh from OSM when you need them.
    </p>
    <p class="home-links muted">
      Leader resources:
      <a href="https://wogglehq.com" rel="noopener noreferrer" target="_blank">Woggle HQ</a>
      · Source:
      <a href="https://github.com/jonbloor/OSMHelper" rel="noopener noreferrer" target="_blank">GitHub</a>
    </p>
  </section>
{% endif %}
{% endblock %}
