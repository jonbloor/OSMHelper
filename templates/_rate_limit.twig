{% if authed is defined and authed %}
<div class="rate-limit-info">
  <p><strong>Your OSM API allowance</strong></p>
  <p class="muted">This is <strong>per user</strong> (your OSM account), not a measure of how busy Online Scout Manager is overall. OSM caps how many API requests your login can make in a short window. Opening tools like Members, Checks, Dashboard, Waiting, Equipment or Bank uses that allowance.</p>
  <ul>
    <li>Limit: {{ rateLimit.limit ?? 'Unknown' }}</li>
    <li>Remaining: {{ rateLimit.remaining ?? 'Unknown' }}</li>
    <li>Resets in: {{ rateResetText|default('Unknown') }}</li>
  </ul>
  {% if rateLimit.remaining is not null and rateLimit.remaining <= 50 %}
    <p class="warning">⚠️ Low remaining requests – use sparingly!</p>
  {% endif %}
</div>
{% endif %}
