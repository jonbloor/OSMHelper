{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>{% if ok %}Item added{% else %}Item was not added{% endif %}</h2>
  {% if ok %}
  <div class="alert">{{ item.name }} is now in {{ listName }}{% if sectionName %} ({{ sectionName }}){% endif %}. OSM row {{ rowId }}.</div>
  {% else %}
  <div class="alert alert-error">{{ error ?: 'OSM did not confirm the new item.' }}</div>
  <p>OSM did not confirm a new row, so this page does not treat it as added. Open Equipment and check the list before trying again.</p>
  {% endif %}
  <div class="table-wrap">
  <table class="data">
    <tbody>
      <tr><th>List</th><td>{{ listName }}</td></tr>
      <tr><th>Name</th><td>{{ item.name }}</td></tr>
      <tr><th>Quantity</th><td>{{ item.quantity != '' ? item.quantity : '—' }}</td></tr>
      <tr><th>Description</th><td style="white-space:pre-wrap">{{ item.description != '' ? item.description : '—' }}</td></tr>
      <tr><th>Condition</th><td>{{ item.condition != '' ? item.condition : '—' }}</td></tr>
      <tr><th>Broken</th><td>{{ item.broken }}</td></tr>
      <tr><th>Location</th><td>{{ item.location != '' ? item.location : '—' }}</td></tr>
      <tr><th>Purchase date</th><td>{{ item.purchaseDate != '' ? item.purchaseDate : '—' }}</td></tr>
      <tr><th>Notes</th><td style="white-space:pre-wrap">{{ item.notes != '' ? item.notes : '—' }}</td></tr>
      <tr><th>Renewal price</th><td>{{ item.renewalPrice != '' ? item.renewalPrice : '—' }}</td></tr>
      {% if ok %}<tr><th>OSM row</th><td>{{ rowId }}</td></tr>{% endif %}
    </tbody>
  </table>
  </div>
  <p class="row" style="margin-top:1rem">
    <a class="btn" href="/equipment/">Back to Equipment</a>
  </p>
</div>
{% endblock %}
