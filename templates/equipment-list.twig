{% extends 'layout.twig' %}
{% block body %}
{% if needsConfig %}
<p class="muted">Using a guessed adults section. Set the Equipment section under <a href="/settings/">Settings</a>.</p>
{% endif %}
<div class="card">
  <h2>Equipment</h2>
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>List</th><th>Item</th><th>Description</th><th>Location</th><th>Qty</th><th>Condition</th><th>Broken</th></tr></thead>
    <tbody>
    {% for e in equipment %}
      <tr><td>{{ e.listName }}</td><td>{{ e.itemName }}</td><td>{{ e.description }}</td><td>{{ e.location }}</td><td>{{ e.quantity }}</td><td>{{ e.condition }}</td><td>{{ e.broken }}</td></tr>
    {% else %}
      <tr><td colspan="7" class="muted">No equipment found.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
