{% extends 'layout.twig' %}
{% block body %}
{% if needsConfig %}
<p class="muted">Using a guessed adults section. Set the Equipment section under <a href="/settings/">Settings</a>.</p>
{% endif %}
<div class="card">
  <h2>Equipment{% if sectionName %} — {{ sectionName }}{% endif %}</h2>
  {% if sectionId is defined and sectionId %}
  <p class="muted">Section id {{ sectionId }} · type {{ sectionType }} · {{ listCount|default(0) }} list(s)</p>
  {% endif %}
  {% if parseHint %}<div class="alert alert-error">{{ parseHint }}</div>{% endif %}
  <div class="table-wrap">
  <table class="data" data-table-tools data-export-name="equipment">
    <thead>
      <tr>
        <th>List</th>
        <th>Name</th>
        <th>Quantity</th>
        <th>Description</th>
        <th>Condition</th>
        <th>Broken</th>
        <th>Location</th>
        <th>Purchase Date</th>
        <th>Notes</th>
        <th>Renewal Price</th>
      </tr>
    </thead>
    <tbody>
    {% for e in equipment %}
      <tr class="{% if e.brokenCount is defined and e.brokenCount > 0 %}row-broken{% endif %}">
        <td>{{ e.listName }}</td>
        <td>{{ e.itemName }}</td>
        <td>{{ e.quantity }}</td>
        <td>{{ e.description }}</td>
        <td>{{ e.condition }}</td>
        <td class="{% if e.brokenCount is defined and e.brokenCount > 0 %}cell-broken{% endif %}">{{ e.broken }}</td>
        <td>{{ e.location }}</td>
        <td>{{ e.purchaseDate }}</td>
        <td class="notes">{{ e.notes }}</td>
        <td>{{ e.renewalPrice }}</td>
      </tr>
    {% else %}
      <tr><td colspan="10" class="muted">No equipment found for this section. If that looks wrong, pick another Equipment section under Settings.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
