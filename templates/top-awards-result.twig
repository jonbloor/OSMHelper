{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>Write result</h2>
  {% if section %}
  <p class="muted">{{ section.name }} ({{ section.type }}){% if challengeBadge %} · {{ challengeBadge.name }}{% endif %} · {{ awardLabel|default('Gold') }}</p>
  {% endif %}
  {% if wrote %}
  <div class="alert">{{ okCount|default(0) }} updated{% if failCount|default(0) > 0 %}; {{ failCount }} failed{% endif %}.</div>
  {% else %}
  <div class="alert alert-error">Nothing updated. See Failed rows below.</div>
  {% endif %}
  <div class="table-wrap">
  <table class="data">
    <thead>
      <tr>
        <th>Name</th>
        <th>Current</th>
        <th>Proposed</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for r in results %}
      <tr>
        <td>{{ r.name }}</td>
        <td><code>{{ r.current|default('—') }}</code></td>
        <td><code>{{ r.proposed }}</code></td>
        <td>{% if r.ok %}OK{% else %}Failed{% endif %}{% if r.message and r.message != 'OK' %} — {{ r.message }}{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="row" style="margin-top:1rem">
    <a class="btn btn-secondary" href="/top-awards/">Back to Top awards</a>
  </p>
</div>
{% endblock %}
