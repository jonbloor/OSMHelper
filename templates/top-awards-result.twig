{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>Write result</h2>
  {% if section %}
  <p class="muted">{{ section.name }} ({{ section.type }}){% if challengeBadge %} · {{ challengeBadge.name }}{% endif %} · {{ awardLabel|default('Gold') }}</p>
  {% endif %}
  {% if wrote %}
  <div class="alert">At least one update was accepted by OSM. Check Failed rows below. Write path: <code>{{ writePathUsed|default('—') }}</code></div>
  {% else %}
  <div class="alert alert-error">
    <p><strong>No members were updated.</strong> OSM rejected every write attempt we know about (often HTTP 403 / invalid-action).</p>
    <p>We are <strong>not guessing another write URL</strong>. To finish this, open OSM, edit one challenge progress cell (e.g. Chief Scout’s Gold “Six badges”), and capture the Network request (URL + method + form/JSON payload). Paste that to Bungle — we will wire Apply to that exact call only.</p>
    <p class="muted">Row status below (and osm-debug) shows what was tried. Export/copy your records before any future write.</p>
  </div>
  {% endif %}
  <div class="table-wrap">
  <table class="data">
    <thead>
      <tr>
        <th>Name</th>
        <th>Current</th>
        <th>Proposed</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for r in results %}
      <tr>
        <td>{{ r.name }}</td>
        <td><code>{{ r.current|default('—') }}</code></td>
        <td><code>{{ r.proposed }}</code></td>
        <td>{% if r.ok %}Updated{% else %}Failed{% endif %}{% if r.message %} — {{ r.message }}{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="row" style="margin-top:1rem">
    <a class="btn btn-secondary" href="/top-awards/">Back to Top awards</a>
  </p>
</div>
{% endblock %}
