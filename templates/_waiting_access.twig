{# Save-permission / kill-switch banners. Expects access, writesEnabled. #}
{% if writesEnabled is defined and not writesEnabled %}
<div class="alert alert-error">Saving to OSM is switched off on this server. You can still view and export.</div>
{% elseif access is defined and not access.canSave %}
<div class="alert">To save ranks and notes, OSMHelper needs your permission to update member records in OSM. <a href="/logout/">Sign out</a>, then sign in again and allow it when OSM asks. You can still view and export in the meantime.</div>
{% endif %}
