{% extends 'layout.twig' %}
{% block body %}
{% if saved %}
<p class="muted">Settings are saved on the server (survive logout).</p>
{% endif %}

<div class="card">
  <h2>WordPress waiting-list form</h2>
  <p class="muted">Parents fill the form on your group website. They never log in to OSM. OSM Helper uses <strong>your</strong> OSM login to write each child into the waiting-list section you choose here. Copy the site key into the WordPress plugin (OSM Helper base URL + site key). Do not put an OSM client id or secret in WordPress.</p>
  <p class="muted">If a parent adds a note on the form, it is saved to the waiting list’s <strong>Notes</strong> field, the one you chose under <a href="/waiting-list/fields/">Waiting list → Rank &amp; notes settings</a>, as a line like <code>05/10/26 10:30 - Parent (website form) - "…"</code>. If no Notes field is chosen, the child is still added, but the note is not saved.</p>
  {% if wpFlash %}
    <p class="{% if wpFlash.type == 'error' %}error{% else %}muted{% endif %}">{{ wpFlash.message }}</p>
  {% endif %}
  {% if wpBlocked %}
    <p class="error">OSM returned <strong>X-Blocked</strong> for this WordPress intake. Further writes are stopped. Clear the block only after fixing the cause.</p>
    <form method="post" action="/settings/update-wordpress-waiting-list/">
      {% include '_csrf.twig' %}
      <input type="hidden" name="wp_action" value="clear_block">
      <button class="btn btn-danger" type="submit">Clear WordPress OSM block</button>
    </form>
  {% endif %}
  <form method="post" action="/settings/update-wordpress-waiting-list/">
    {% include '_csrf.twig' %}
    <input type="hidden" name="wp_action" value="save">
    <label>Waiting-list section
      <select name="waiting_list_section_id" required>
        <option value="">— choose your OSM waiting list —</option>
        {% for l in waitingLists %}
          <option value="{{ l.id }}" {% if wpSectionId == l.id %}selected{% endif %}>{{ l.name }}{% if l.groupName %} ({{ l.groupName }}){% endif %} — id {{ l.id }}</option>
        {% endfor %}
      </select>
    </label>
    {% if waitingLists is empty %}
      <p class="muted">No waiting-list section found for this login. Check in OSM that you can see the group’s waiting list, then sign out and sign in again.</p>
    {% endif %}
    <p class="muted">Endpoint WordPress calls: <code>{{ wpEndpoint }}</code></p>
    {% if wpSiteKey %}
      <label>Site key (paste into WordPress)
        <input type="text" readonly value="{{ wpSiteKey }}" onclick="this.select();" class="mono" aria-label="WordPress site key">
      </label>
      <p class="muted">Treat this like a password. Anyone with the key can submit waiting-list members into your chosen section.</p>
    {% else %}
      <p class="muted">Save to create a site key. It will appear here for you to copy.</p>
    {% endif %}
    <p>
      <button class="btn" type="submit">Save WordPress waiting list</button>
      <button class="btn btn-secondary" type="submit" name="regenerate_key" value="1">Save &amp; regenerate site key</button>
    </p>
  </form>
  {% if wpSiteKey %}
  <form method="post" action="/settings/update-wordpress-waiting-list/" onsubmit="return confirm('Remove the WordPress site key? The plugin will stop accepting waiting-list forms until you create a new key.');">
    {% include '_csrf.twig' %}
    <input type="hidden" name="wp_action" value="disable">
    <button class="btn btn-danger" type="submit">Disable WordPress intake</button>
  </form>
  {% endif %}
</div>
<div class="card">
  <h2>Age cutoffs</h2>
  <form method="post" action="/settings/update-cutoffs/">
    {% include '_csrf.twig' %}
    <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Section</th><th>Years</th><th>Months</th></tr></thead>
      <tbody>
      {% for key, c in displayCutoffs %}
        <tr>
          <td>{{ key }}</td>
          <td><input type="number" name="{{ key }}_years" value="{{ c.years }}" min="0" max="18"></td>
          <td><input type="number" name="{{ key }}_months" value="{{ c.months }}" min="0" max="11"></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    <button class="btn" type="submit">Save cutoffs</button>
  </form>
</div>
<div class="card">
  <h2>Section capacity &amp; visibility</h2>
  <p class="muted">Set capacity per OSM section (editable). Defaults shown for reference.</p>
  <form method="post" action="/settings/update-sections/">
    {% include '_csrf.twig' %}
    <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Show</th><th>Section</th><th>Type</th><th>Capacity</th><th>Default</th></tr></thead>
      <tbody>
      {% for s in displaySections %}
        <tr>
          <td><input type="checkbox" name="visible_{{ s.id }}" {% if s.visible %}checked{% endif %}></td>
          <td>{{ s.name }}</td>
          <td>{{ s.typeLabel }}</td>
          <td><input type="number" name="capacity_{{ s.id }}" value="{{ s.capacity }}" min="0"></td>
          <td class="muted">{{ s.defaultCapacity }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    <button class="btn" type="submit">Save sections</button>
  </form>
</div>
<div class="card">
  <h2>Tool sections</h2>
  <p class="muted">One-time picks: which OSM section Equipment and Bank transfers use. Change anytime here.</p>
  <form method="post" action="/settings/update-tool-sections/">
    {% include '_csrf.twig' %}
    <label>Equipment section
      <select name="equipmentSectionId">
        <option value="">— use first adults section —</option>
        {% for s in allSections %}
          <option value="{{ s.id }}|{{ s.type }}" {% if equipmentSectionId == s.id %}selected{% endif %}>{{ s.name }} ({{ s.typeLabel }})</option>
        {% endfor %}
      </select>
    </label>
    <label>Bank / finance section
      <select name="financeSectionId">
        <option value="">— not set —</option>
        {% for s in allSections %}
          <option value="{{ s.id }}|{{ s.type }}" {% if financeSectionId == s.id %}selected{% endif %}>{{ s.name }} ({{ s.typeLabel }})</option>
        {% endfor %}
      </select>
    </label>
    <button class="btn" type="submit">Save tool sections</button>
  </form>
</div>
<div class="card">
  <h2>Equipment locations</h2>
  <p class="muted">Named places for kit (shed, trailer, HQ loft, …). Used when updating equipment locations. Order is the dropdown order.</p>
  <form method="post" action="/settings/update-equipment-locations/" id="equipment-locations-form">
    {% include '_csrf.twig' %}
    <ul class="location-list" id="equipment-location-list">
      {% for loc in equipmentLocations %}
      <li class="location-row">
        <input type="text" name="locations[]" value="{{ loc }}" maxlength="120" aria-label="Location name">
        <span class="location-actions">
          <button type="button" class="btn btn-secondary btn-small" data-loc-up title="Move up">↑</button>
          <button type="button" class="btn btn-secondary btn-small" data-loc-down title="Move down">↓</button>
          <button type="button" class="btn btn-danger btn-small" data-loc-remove title="Remove">Remove</button>
        </span>
      </li>
      {% else %}
      <li class="location-row location-empty muted">No locations yet — add one below.</li>
      {% endfor %}
    </ul>
    <div class="row location-add">
      <input type="text" id="new-location-input" maxlength="120" placeholder="New location name" aria-label="New location name">
      <button type="button" class="btn btn-secondary" id="add-location-btn">Add</button>
    </div>
    <p class="muted">Tip: edit names in place, reorder with ↑↓, then save.</p>
    <button class="btn" type="submit">Save locations</button>
  </form>
</div>
<script>
(function () {
  var list = document.getElementById('equipment-location-list');
  var addBtn = document.getElementById('add-location-btn');
  var addInput = document.getElementById('new-location-input');
  if (!list || !addBtn || !addInput) return;

  function clearEmpty() {
    var empty = list.querySelector('.location-empty');
    if (empty) empty.remove();
  }

  function makeRow(value) {
    var li = document.createElement('li');
    li.className = 'location-row';
    li.innerHTML =
      '<input type="text" name="locations[]" value="" maxlength="120" aria-label="Location name">' +
      '<span class="location-actions">' +
      '<button type="button" class="btn btn-secondary btn-small" data-loc-up title="Move up">↑</button>' +
      '<button type="button" class="btn btn-secondary btn-small" data-loc-down title="Move down">↓</button>' +
      '<button type="button" class="btn btn-danger btn-small" data-loc-remove title="Remove">Remove</button>' +
      '</span>';
    li.querySelector('input').value = value;
    return li;
  }

  addBtn.addEventListener('click', function () {
    var v = (addInput.value || '').trim();
    if (!v) { addInput.focus(); return; }
    clearEmpty();
    list.appendChild(makeRow(v));
    addInput.value = '';
    addInput.focus();
  });
  addInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); addBtn.click(); }
  });

  list.addEventListener('click', function (e) {
    var btn = e.target.closest('button');
    if (!btn) return;
    var row = btn.closest('.location-row');
    if (!row || !list.contains(row)) return;
    if (btn.hasAttribute('data-loc-remove')) {
      row.remove();
      if (!list.querySelector('.location-row')) {
        var empty = document.createElement('li');
        empty.className = 'location-row location-empty muted';
        empty.textContent = 'No locations yet — add one below.';
        list.appendChild(empty);
      }
      return;
    }
    if (btn.hasAttribute('data-loc-up') && row.previousElementSibling) {
      list.insertBefore(row, row.previousElementSibling);
    }
    if (btn.hasAttribute('data-loc-down') && row.nextElementSibling) {
      list.insertBefore(row.nextElementSibling, row);
    }
  });
})();
</script>
{% endblock %}
