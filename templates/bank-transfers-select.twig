{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>Select finance section</h2>
  <p class="muted">No section with accounts access was auto-detected. Pick one:</p>
  <form method="post" action="/bank-transfers/select">
    <label>Section
      <select name="sectionId" required>
        {% for s in sections if s.section_id is defined %}
          <option value="{{ s.section_id }}">{{ s.section_name }} ({{ s.section_type }})</option>
        {% endfor %}
      </select>
    </label>
    <input type="hidden" name="sectionType" value="adults">
    <button class="btn" type="submit">Continue</button>
  </form>
</div>
{% endblock %}
