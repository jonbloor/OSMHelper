{# Shown on waiting list pages when a load was cut short to protect the OSM allowance. #}
{% if loadBusyMinutes|default(null) and not listError|default(null) %}
  <p class="alert alert-error" role="status">OSM is busy, try again in {{ loadBusyMinutes }} minute{{ loadBusyMinutes == 1 ? '' : 's' }}. Some details below weren’t loaded. OSMHelper has paused its requests to protect your OSM allowance. <a href="/help/#osm-busy">Why?</a></p>
{% elseif detailsSkipped|default(0) > 0 %}
  <p class="alert" role="status">{{ detailsSkipped }} applicant{{ detailsSkipped == 1 ? '’s' : 's’' }} details weren’t loaded this time, to protect your OSM allowance. Open this page again in a few minutes and more will fill in. <a href="/help/#osm-busy">Why?</a></p>
{% endif %}
