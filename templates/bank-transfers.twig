{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  <h2>Bank transfers{% if sectionName %} — {{ sectionName }}{% endif %}</h2>
  {% if sectionId is defined and sectionId %}<p class="muted">Section id {{ sectionId }} · type {{ sectionType }} · {{ accountCount|default(0) }} account(s) · fetched {{ fetchedAt }}</p>{% endif %}
  {% if parseHint %}<div class="alert alert-error">{{ parseHint }}</div>{% endif %}
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>Date</th><th>Account</th><th>Reference</th><th>Amount</th></tr></thead>
    <tbody>
    {% for t in transfers %}
      <tr><td>{{ t.date }}</td><td>{{ t.accountName }}</td><td>{{ t.reference }}</td><td>{{ t.amount }}</td></tr>
    {% else %}
      <tr><td colspan="4" class="muted">No transfers found.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
