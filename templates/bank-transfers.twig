{% extends 'layout.twig' %}
{% block body %}
<div class="card">
  {% if view == 'transactions' %}
  <h2>Bank — {{ account.name }}{% if sectionName %} <span class="muted">({{ sectionName }})</span>{% endif %}</h2>
  <p class="muted">
    Account {{ account.id }} · balance {{ account.currentBalance }}
    {% if account.lastTransactionDate %} · last tx {{ account.lastTransactionDate }}{% endif %}
    · fetched {{ fetchedAt }}
  </p>
  <p class="row">
    <a class="btn btn-secondary" href="/bank-transfers/{% if showDeleted %}?deleted=1{% endif %}">← All accounts</a>
  </p>
  {% if txTotal is not null %}
  <p class="muted">Showing {{ transactions|length }} of {{ txTotal }} transaction(s){% if txPagesFetched > 1 %} ({{ txPagesFetched }} page(s) fetched){% endif %}.</p>
  {% endif %}
  <div class="table-wrap">
  <table class="data" data-table-tools data-export-name="bank-{{ account.id }}">
    <thead>
      <tr>
        <th>Date</th>
        <th>Reference</th>
        <th>Amount</th>
        <th>Type</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
    {% for t in transactions %}
      <tr class="{% if t.isTransfer %}row-transfer{% endif %}">
        <td>{{ t.date }}</td>
        <td>{{ t.reference }}</td>
        <td>{{ t.amount }}</td>
        <td>{{ t.type }}</td>
        <td>{{ t.description }}</td>
      </tr>
    {% else %}
      <tr><td colspan="5" class="muted">No transactions returned for this account.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if txTotal is not null and transactions|length < txTotal %}
  <p class="muted">More transactions exist in OSM — open another page with <code>?account={{ account.id }}&amp;page={{ txPage + txPagesFetched }}</code> if needed (rate-limit friendly).</p>
  {% endif %}

  {% else %}
  <h2>Bank{% if sectionName %} — {{ sectionName }}{% endif %}</h2>
  {% if sectionId is defined and sectionId %}
  <p class="muted">Section id {{ sectionId }} · type {{ sectionType }} · {{ activeCount|default(0) }} active account(s){% if deletedCount %} · {{ deletedCount }} deleted{% endif %} · fetched {{ fetchedAt }}</p>
  {% endif %}
  <p class="muted">Balances from OSM accounting (pence ÷ 100). Click an account for transactions. {% if showDeleted %}<a href="/bank-transfers/">Hide deleted</a>{% else %}<a href="/bank-transfers/?deleted=1">Show deleted</a>{% endif %}.</p>
  <div class="table-wrap">
  <table class="data" data-table-tools data-export-name="bank-accounts">
    <thead>
      <tr>
        <th>Account</th>
        <th>Balance</th>
        <th>Last transaction</th>
        <th>Unprocessed</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for a in accounts %}
      <tr class="{% if a.deleted %}row-deleted{% endif %}">
        <td>
          {% if a.deleted %}
            {{ a.name }}
          {% else %}
            <a href="/bank-transfers/?account={{ a.id }}{% if showDeleted %}&amp;deleted=1{% endif %}">{{ a.name }}</a>
          {% endif %}
          <span class="muted"> · {{ a.id }}</span>
        </td>
        <td>{{ a.currentBalance }}</td>
        <td>{{ a.lastTransactionDate|default('—') }}</td>
        <td>{{ a.unprocessed }}</td>
        <td>{% if a.deleted %}Deleted{% if a.deletedAt %} ({{ a.deletedAt }}){% endif %}{% else %}Active{% endif %}</td>
      </tr>
    {% else %}
      <tr><td colspan="5" class="muted">No bank accounts returned for this section. Check Settings → Bank / finance section and OSM finance access.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
</div>
{% endblock %}
