# Server session signing key (generate a long random string)
SESSION_SECRET=

# OSM OAuth application credentials (register at OSM developer portal)
CLIENT_ID=
CLIENT_SECRET=

# Must match the redirect URI registered with OSM exactly
# Production: https://osmhelper.co.uk/callback
REDIRECT_URI=https://osmhelper.co.uk/callback

# Key that encrypts the OSM tokens saved for the WordPress joining form (storage/osmhelper.sqlite).
# 32 random bytes, base64. Generate it straight into .env so it is never shown (deploy.sh does this):
#   php deploy/ensure-token-key.php
# Keep it secret and never change it once tokens are saved (old tokens could not be read; leaders
# would need to sign in and save the form again). See docs/DEPLOY-RUNBOOK.md.
OSMHELPER_TOKEN_KEY=

# Optional overrides
# OSM_API_BASE=https://www.onlinescoutmanager.co.uk
# APP_DEBUG=false

# Comma-separated OSM user IDs who see the OSM API error log (all groups) on the signed-in home page.
# Nobody else sees that panel. Unset/empty: nobody sees it.
# ADMIN_OSM_USER_IDS=

# Waiting list ranking (rank/notes writes to OSM)
# When set, rank/notes writes only go to this one OSM member id (safe testing). Leave blank for normal use.
# WAITING_RANK_TEST_MEMBER=
# Set to off to disable all rank/notes writes (read-only kill switch).
# WAITING_RANK_WRITES=
