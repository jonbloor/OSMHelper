# Server session signing key (generate a long random string)
SESSION_SECRET=

# OSM OAuth application credentials (register at OSM developer portal)
CLIENT_ID=
CLIENT_SECRET=

# Must match the redirect URI registered with OSM exactly
# Production: https://osmhelper.co.uk/callback
REDIRECT_URI=https://osmhelper.co.uk/callback

# Optional overrides
# OSM_API_BASE=https://www.onlinescoutmanager.co.uk
# APP_DEBUG=false

# Waiting list ranking (rank/notes writes to OSM)
# When set, rank/notes writes only go to this one OSM member id (safe testing). Leave blank for normal use.
# WAITING_RANK_TEST_MEMBER=
# Set to off to disable all rank/notes writes (read-only kill switch).
# WAITING_RANK_WRITES=
